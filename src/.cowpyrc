{
    'handlers': {
        'exception_handler': {
            'class': 'logging.FileHandler',
            'filename': './logs/bckt_exceptions.log',
            'level': 'WARNING',
            "format": "Format.DETAILED"
        },
        'internal_logger': {
            'class': 'logging.FileHandler',
            'filename': './logs/bckt.log',
            'level': 'DEBUG'            
        },
        'user_console': {
            'class': 'logging.StreamHandler',
            'format': 'Format.USER',
            'level': 'DEBUG'
        },
    },
    'loggers': {    
        'urllib3': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },
        'botocore': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'INFO',
        },
        'boto3': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'INFO',
        },
        's3transfer': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },
        'database': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
            'force': 'True'
        },
        'model': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
            'force': 'True'
        },
        'common': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },
        'columnizer': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },
        'awsclient': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },
        'init': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },
        'config': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },
        'bckt': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },
        'bcktdb': {
            'handlers': ['internal_logger', 'exception_handler'],
            'level': 'DEBUG',
        },        
        'user': {
            'handlers': ['user_console'],
            'level': 'DEBUG',
        }
    }
}
